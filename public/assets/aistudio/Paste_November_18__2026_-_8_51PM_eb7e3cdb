                                    `<button class="btn" onclick="openPayment(${b.id}, '${b.title}')" style="background:#059669;">Buy Book</button>`
                                }
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function fetchLibrary() {
