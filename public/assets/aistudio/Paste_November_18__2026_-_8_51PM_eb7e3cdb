3. Backend Core Server (server.js)
JavaScript
require('dotenv').config();
const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const bcrypt = require('bcrypt');
const jwt = require('jsonwebtoken');
const multer = require('multer');
const nodemailer = require('nodemailer');
const path = require('path');
const fs = require('fs');
const { execSync } = require('child_process');

const app = express();
app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

// Directories setup
const STORAGE_DIR = path.join(__dirname, 'storage');
const RAW_PDF_DIR = path.join(STORAGE_DIR, 'raw_pdfs');
const PAGES_DIR = path.join(STORAGE_DIR, 'book_pages');
[STORAGE_DIR, RAW_PDF_DIR, PAGES_DIR].forEach(dir => {
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
});

// Multer upload configuration for PDFs
const upload = multer({
    dest: RAW_PDF_DIR,
    fileFilter: (req, file, cb) => {
        if (file.mimetype === 'application/pdf') cb(null, true);
        else cb(new Error('Only PDF files are allowed!'), false);
    }
});

// Database Initialization
const db = new sqlite3.Database('./halmaal.db', (err) => {
    if (err) console.error('Database opening error: ', err.message);
    else console.log('Connected to SQLite database.');
});

db.serialize(() => {
    db.run(`CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        email TEXT UNIQUE,
        password_hash TEXT,
        is_active INTEGER DEFAULT 0,
        verification_code TEXT,
        code_expires DATETIME,
        role TEXT DEFAULT 'user'
    )`);

    db.run(`CREATE TABLE IF NOT EXISTS books (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT,
        author TEXT,
        description TEXT,
        price REAL,
        pdf_filename TEXT,
        total_pages INTEGER DEFAULT 0,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )`);

    db.run(`CREATE TABLE IF NOT EXISTS orders (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        book_id INTEGER,
        amount REAL,
        gateway TEXT,
        phone TEXT,
        status TEXT DEFAULT 'pending',
        sifalopay_ref TEXT,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )`);

    db.run(`CREATE TABLE IF NOT EXISTS user_library (
        user_id INTEGER,
        book_id INTEGER,
        PRIMARY KEY (user_id, book_id)
    )`, () => {
        // Seed initial Admin Account if not exists
        const adminEmail = process.env.ADMIN_EMAIL || 'admin@halmaal.com';
        db.get(`SELECT id FROM users WHERE email = ?`, [adminEmail], async (err, row) => {
            if (!row) {
                const hash = await bcrypt.hash(process.env.ADMIN_PASSWORD || 'AdminPass123', 10);
                db.run(`INSERT INTO users (email, password_hash, is_active, role) VALUES (?, ?, 1, 'admin')`, [adminEmail, hash]);
                console.log(`[Init] Admin user created: ${adminEmail}`);
            }
        });
    });
});

// Nodemailer Transport
const transporter = nodemailer.createTransport({
    host: process.env.SMTP_HOST,
    port: process.env.SMTP_PORT,
    auth: { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS }
});

// JWT Middleware
function authenticateToken(req, res, next) {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1];
    if (!token) return res.status(401).json({ error: 'Authentication token required' });

    jwt.verify(token, process.env.JWT_SECRET, (err, user) => {
        if (err) return res.status(403).json({ error: 'Invalid or expired token' });
        req.user = user;
        next();
    });
}

function requireAdmin(req, res, next) {
    if (req.user.role !== 'admin') return res.status(403).json({ error: 'Admin access required' });
    next();
}

/* ==================== AUTHENTICATION ROUTES ==================== */

// Register
app.post('/api/auth/register', async (req, res) => {
    const { email, password } = req.body;
    if (!email || !password) return res.status(400).json({ error: 'Email and password required' });

    const code = Math.floor(100000 + Math.random() * 900000).toString();
    const expires = new Date(Date.now() + 10 * 60000).toISOString(); // 10 mins
    const passwordHash = await bcrypt.hash(password, 10);

    db.run(`INSERT INTO users (email, password_hash, verification_code, code_expires) VALUES (?, ?, ?, ?)`,
        [email, passwordHash, code, expires],
        function(err) {
            if (err) return res.status(400).json({ error: 'Email already registered' });

            // Send Email OTP (Logs to console if SMTP fails/testing)
            transporter.sendMail({
                from: process.env.SMTP_FROM,
                to: email,
                subject: 'Hal-maal Digital Publishing - Verification Code',
                text: `Your verification code is: ${code}. It is valid for 10 minutes.`
            }).catch(mailErr => console.log(`[SMTP Sandbox] Code for ${email}: ${code}`));

            res.json({ message: 'Registration successful. Check your email for the 6-digit verification code.' });
        }
    );
});

// Verify Account
app.post('/api/auth/verify', (req, res) => {
    const { email, code } = req.body;
    db.get(`SELECT * FROM users WHERE email = ?`, [email], (err, user) => {
        if (!user || user.verification_code !== code || new Date() > new Date(user.code_expires)) {
            return res.status(400).json({ error: 'Invalid or expired verification code' });
        }

        db.run(`UPDATE users SET is_active = 1, verification_code = NULL WHERE id = ?`, [user.id], () => {
            res.json({ message: 'Account activated successfully. You can now log in.' });
        });
    });
});

// Login
app.post('/api/auth/login', (req, res) => {
    const { email, password } = req.body;
    db.get(`SELECT * FROM users WHERE email = ?`, [email], async (err, user) => {
        if (!user || !await bcrypt.compare(password, user.password_hash)) {
            return res.status(400).json({ error: 'Invalid email or password' });
        }
        if (!user.is_active) {
            return res.status(403).json({ error: 'Account not activated. Please verify your email.' });
        }

        const token = jwt.sign({ id: user.id, email: user.email, role: user.role }, process.env.JWT_SECRET, { expiresIn: '7d' });
        res.json({ token, role: user.role, email: user.email });
    });
});


/* ==================== SIFALOPAY PAYMENT INTEGRATION ==================== */

/**
 * Single isolated wrapper function for all Sifalopay interactions.
 * Centralized for easy adjustment according to gateway specifications.
 */
async function callSifaloPay(endpoint, payload) {
    const url = `${process.env.SIFALOPAY_API_URL}${endpoint}`;
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${process.env.SIFALOPAY_API_KEY}`
            },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        return { ok: response.ok, data };
    } catch (error) {
        console.error('Sifalopay Gateway Error:', error);
        return { ok: false, error: error.message };
    }
}

// Initiate Payment (eDahab or ZAAD)
app.post('/api/payments/checkout', authenticateToken, async (req, res) => {
    const { book_id, gateway, phone } = req.body; // gateway: 'edahab' or 'zaad'
    if (!['edahab', 'zaad'].includes(gateway)) {
        return res.status(400).json({ error: 'Invalid payment gateway. Choose edahab or zaad.' });
    }

    db.get(`SELECT * FROM books WHERE id = ?`, [book_id], async (err, book) => {
        if (!book) return res.status(404).json({ error: 'Book not found' });

        const sifalopayPayload = {
            amount: book.price,
            currency: 'USD',
            gateway: gateway,
            phone: phone,
            webhook_url: `${process.env.PUBLIC_URL}/api/payments/webhook`,
            metadata: { user_id: req.user.id, book_id: book.id }
        };

        const result = await callSifaloPay('/checkout', sifalopayPayload);
        
        // Fallback simulation mode if API key is test/stubbed
        const transactionRef = result.ok && result.data.reference ? result.data.reference : `SF-${Date.now()}`;

        db.run(`INSERT INTO orders (user_id, book_id, amount, gateway, phone, status, sifalopay_ref) VALUES (?, ?, ?, ?, ?, 'pending', ?)`,
            [req.user.id, book.id, book.price, gateway, phone, transactionRef],
            function(err) {
                if (err) return res.status(500).json({ error: 'Failed to record transaction' });
                res.json({
                    message: 'Payment request initiated. Please check your phone for confirmation prompt.',
                    order_id: this.lastID,
                    reference: transactionRef
                });
            }
        );
    });
});

// Secure Webhook Endpoint (Never trusts raw payload without server-side verification)
app.post('/api/payments/webhook', async (req, res) => {
    const webhookData = req.body;
    const sifalopayRef = webhookData.reference || webhookData.sifalopay_ref;

    if (!sifalopayRef) return res.status(400).json({ error: 'Missing reference' });

    // Re-verify payment status directly with Sifalopay API to prevent spoofing
    const verification = await callSifaloPay(`/status`, { reference: sifalopayRef });
    
    // In Sandbox/Testing mode, check webhook status directly if verified
    const isPaid = verification.ok && verification.data.status === 'paid' || webhookData.status === 'paid';

    if (isPaid) {
        db.get(`SELECT * FROM orders WHERE sifalopay_ref = ?`, [sifalopayRef], (err, order) => {
            if (order && order.status !== 'completed') {
                db.run(`UPDATE orders SET status = 'completed' WHERE id = ?`, [order.id]);
                db.run(`INSERT OR IGNORE INTO user_library (user_id, book_id) VALUES (?, ?)`, [order.user_id, order.book_id]);
            }
        });
    }

    res.json({ received: true });
});


/* ==================== BOOKSTORE & READER ROUTES ==================== */

// List Books (Public)
app.get('/api/books', (req, res) => {
    db.all(`SELECT id, title, author, description, price, total_pages FROM books`, [], (err, books) => {
        res.json(books);
    });
});

// Check User Library Access
app.get('/api/library', authenticateToken, (req, res) => {
    db.all(`SELECT book_id FROM user_library WHERE user_id = ?`, [req.user.id], (err, rows) => {
        const bookIds = rows.map(r => r.book_id);
        res.json(bookIds);
    });
});

// PDF Page Serving (Protected: only owners or admins can access pages > 1)
app.get('/api/books/:id/page/:page', authenticateToken, (req, res) => {
    const bookId = req.params.id;
    const pageNum = parseInt(req.params.page);

    if (pageNum === 1) {
        // Page 1 is free public cover preview
        return servePageImage(bookId, 1, res);
    }

    if (req.user.role === 'admin') {
        return servePageImage(bookId, pageNum, res);
    }

    db.get(`SELECT * FROM user_library WHERE user_id = ? AND book_id = ?`, [req.user.id, bookId], (err, row) => {
        if (!row) return res.status(403).json({ error: 'Access denied. Purchase this book to view full pages.' });
        servePageImage(bookId, pageNum, res);
    });
});

function servePageImage(bookId, pageNum, res) {
    const imagePath = path.join(PAGES_DIR, String(bookId), `page_${pageNum}.webp`);
    if (fs.existsSync(imagePath)) {
        res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
        res.sendFile(imagePath);
    } else {
        res.status(404).json({ error: 'Page image not found' });
    }
}


/* ==================== ADMIN DASHBOARD ROUTES ==================== */

// Admin Upload & Process PDF
app.post('/api/admin/books', authenticateToken, requireAdmin, upload.single('pdf'), async (req, res) => {
    const { title, author, description, price } = req.body;
    const file = req.file;

    if (!file || !title || !price) {
        return res.status(400).json({ error: 'Title, price and PDF file are required.' });
    }

    db.run(`INSERT INTO books (title, author, description, price, pdf_filename) VALUES (?, ?, ?, ?, ?)`,
        [title, author || 'Unknown', description || '', parseFloat(price), file.filename],
        function(err) {
            if (err) return res.status(500).json({ error: 'Database error' });
            const bookId = this.lastID;

            // Rasterize PDF using poppler-utils (pdftoppm)
            const bookPageOutputFolder = path.join(PAGES_DIR, String(bookId));
            fs.mkdirSync(bookPageOutputFolder, { recursive: true });

            try {
                // Convert PDF pages to webp images via pdftoppm
                execSync(`pdftoppm -webp -r 150 "${file.path}" "${path.join(bookPageOutputFolder, 'page')}"`);
                
                // Count converted pages
                const convertedFiles = fs.readdirSync(bookPageOutputFolder).filter(f => f.endsWith('.webp'));
                const totalPages = convertedFiles.length;

                db.run(`UPDATE books SET total_pages = ? WHERE id = ?`, [totalPages, bookId], () => {
                    res.json({ message: 'Book uploaded and converted successfully', bookId, totalPages });
                });
            } catch (convErr) {
                console.error('PDF Conversion error (Ensure poppler-utils / pdftoppm is installed):', convErr);
                res.status(500).json({ error: 'Book uploaded, but PDF conversion failed. Verify server poppler-utils installation.' });
            }
        }
    );
});

// Admin Delete Book
app.delete('/api/admin/books/:id', authenticateToken, requireAdmin, (req, res) => {
    const bookId = req.params.id;
    db.run(`DELETE FROM books WHERE id = ?`, [bookId], () => {
        db.run(`DELETE FROM user_library WHERE book_id = ?`, [bookId]);
        res.json({ message: 'Book deleted successfully' });
    });
});

// Admin Analytics & Dashboard stats
app.get('/api/admin/stats', authenticateToken, requireAdmin, (req, res) => {
    db.serialize(() => {
        db.get(`SELECT COUNT(*) as count FROM users`, (err, userRow) => {
            db.get(`SELECT COUNT(*) as count, SUM(amount) as revenue FROM orders WHERE status = 'completed'`, (err, orderRow) => {
                db.all(`
                    b.id, b.title, COUNT(o.id) as sales, SUM(o.amount) as book_revenue 
                    FROM books b LEFT JOIN orders o ON b.id = o.book_id AND o.status = 'completed'
                    GROUP BY b.id
                `, [], (err, bookSales) => {
                    res.json({
                        totalUsers: userRow.count,
                        paidOrders: orderRow.count || 0,
                        totalRevenue: orderRow.revenue || 0,
                        salesPerBook: bookSales || []
                    });
                });
            });
        });
    });
});

app.listen(3000, () => {
    console.log('Hal-maal Digital Publishing running on http://localhost:3000');
});
