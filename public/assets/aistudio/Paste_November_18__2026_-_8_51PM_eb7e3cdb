        async function fetchAdminStats() {
            const res = await fetch('/api/admin/stats', { headers: { 'Authorization': `Bearer ${token}` } });
            const stats = await res.json();
            document.getElementById('admin-stats').innerHTML = `
                <div><strong>Users:</strong> ${stats.totalUsers}</div>
                <div><strong>Paid Orders:</strong> ${stats.paidOrders}</div>
                <div><strong>Revenue:</strong> $${stats.totalRevenue ? stats.totalRevenue.toFixed(2) : '0.00'}</div>
            `;
        }

        // Flipbook Reader Integration
        function openReader(bookId, totalPages) {
            const readerView = document.getElementById('reader-view');
            const flipbookEl = document.getElementById('flipbook');
            readerView.style.display = 'flex';
            flipbookEl.innerHTML = '';

            for (let i = 1; i <= totalPages; i++) {
                const pageDiv = document.createElement('div');
                pageDiv.className = 'page';
                pageDiv.innerHTML = `<img src="/api/books/${bookId}/page/${i}?token=${token}" alt="Page ${i}">`;
                flipbookEl.appendChild(pageDiv);
            }

            try {
                window.pageFlip = new St.PageFlip(flipbookEl, {
                    width: 450,
                    height: 600,
                    size: "stretch",
                    minWidth: 300,
                    maxWidth: 600,
                    minHeight: 400,
                    maxHeight: 800,
                    showCover: true
                });
                window.pageFlip.loadFromHTML(document.querySelectorAll('.page'));
            } catch (err) { console.error('Flipbook init error:', err); }
        }

        function closeReader() {
            document.getElementById('reader-view').style.display = 'none';
            if (window.pageFlip) window.pageFlip.destroy();
        }

        // Block shortcuts and inspect shortcuts in reader
        document.addEventListener('keydown', e => {
            if ((e.ctrlKey && ['s','p','u','c'].includes(e.key.toLowerCase())) || e.key === 'F12') {
                e.preventDefault();
            }
        });

        init();
    </script>
