            const res = await fetch('/api/admin/books', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData
            });
            const data = await res.json();
            if (res.ok) {
                alert('Book uploaded successfully!');
                location.reload();
            } else { alert(data.error); }
